/* EmuStation5 - light theme. Keeps rule-for-rule parity with launcher.qss.
   Same layout and PS-blue accents, with a light color scheme. */

QMainWindow#MainDialog,
QDialog#MainDialog {
    background: #f4f6fa;
}

QWidget#centralwidget,
QWidget#game_area,
QWidget#content_area {
    background: transparent;
}

/* --- Top brand bar ------------------------------------------------------ */

QFrame#launcher_header {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #ffffff, stop:1 #eef2f8);
    border: 0;
    border-bottom: 1px solid #d8dfe9;
}

QLabel#brand_mark {
    background: transparent;
}

QLabel#brand_title {
    color: #131922;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#label_Version {
    color: #6b7686;
    font-size: 11px;
    padding: 2px 4px;
}

QLabel#check_updates_link {
    color: #0066c0;
    font-size: 11px;
    padding-right: 8px;
}

QLabel#check_updates_link:disabled {
    color: #a4adba;
}

/* --- Left navigation rail ----------------------------------------------- */

QFrame#ps_nav_rail {
    background: #eef2f8;
    border: 0;
    border-right: 1px solid #d8dfe9;
}

QToolButton#nav_play_button,
QToolButton#nav_trophies_button,
QToolButton#nav_settings_button,
QToolButton#nav_search_button,
QToolButton#nav_more_button {
    background: transparent;
    color: #566273;
    border: 0;
    border-left: 3px solid transparent;
    border-radius: 8px;
    min-width: 72px;
    min-height: 64px;
    padding: 8px 4px;
    font-size: 11px;
}

QToolButton#nav_play_button:hover,
QToolButton#nav_trophies_button:hover,
QToolButton#nav_settings_button:hover,
QToolButton#nav_search_button:hover,
QToolButton#nav_more_button:hover {
    background: rgba(0, 0, 0, 8);
    color: #131922;
}

QToolButton#nav_play_button:checked,
QToolButton#nav_trophies_button:checked,
QToolButton#nav_settings_button:checked,
QToolButton#nav_search_button:checked,
QToolButton#nav_more_button:checked,
QToolButton#nav_play_button:focus,
QToolButton#nav_trophies_button:focus,
QToolButton#nav_settings_button:focus,
QToolButton#nav_search_button:focus,
QToolButton#nav_more_button:focus {
    background: rgba(0, 112, 209, 18);
    color: #0066c0;
    border-left: 3px solid #0070d1;
    outline: 0;
}

QToolButton#nav_play_button:pressed,
QToolButton#nav_trophies_button:pressed,
QToolButton#nav_settings_button:pressed,
QToolButton#nav_search_button:pressed,
QToolButton#nav_more_button:pressed {
    background: rgba(0, 112, 209, 38);
}

/* --- Menu bar / menus --------------------------------------------------- */

QMenuBar {
    background: transparent;
    color: #3a4553;
    border: 0;
    padding: 2px 4px;
    spacing: 2px;
}

QMenuBar::item {
    background: transparent;
    color: #3a4553;
    padding: 4px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background: #0070d1;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background: #005aad;
    color: #ffffff;
}

QMenu {
    background: #ffffff;
    color: #202a36;
    border: 1px solid #d8dfe9;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 28px 7px 22px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: #0070d1;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #a4adba;
}

QMenu::separator {
    height: 1px;
    background: #e3e8f0;
    margin: 5px 8px;
}

/* --- Status bar -------------------------------------------------------- */

QStatusBar#launcher_status_bar {
    background: #ffffff;
    color: #5d6878;
    border: 0;
    border-top: 1px solid #d8dfe9;
    min-height: 28px;
}

QStatusBar#launcher_status_bar::item {
    border: 0;
    margin: 0 4px;
}

QLabel#status_games {
    color: #00529c;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 600;
    background: rgba(0, 112, 209, 18);
    border: 1px solid rgba(0, 112, 209, 45);
    border-radius: 12px;
    margin-right: 8px;
}

QLabel#status_settings,
QLabel#status_emulator {
    color: #6b7686;
    padding: 4px 12px;
    font-size: 11px;
}

/* --- Library toolbar --------------------------------------------------- */

QToolButton#refresh_button,
QToolButton#global_settings_button,
QToolButton#input_mapping_button,
QToolButton#edit_button,
QToolButton#delete_button,
QToolButton#trophy_overview_button,
QToolButton#sort_button,
QToolButton#grid_view_button {
    background: rgba(0, 0, 0, 4);
    border: 1px solid rgba(0, 0, 0, 10);
    border-radius: 8px;
    min-width: 32px;
    min-height: 32px;
    padding: 5px;
}

QToolButton#refresh_button:hover,
QToolButton#global_settings_button:hover,
QToolButton#input_mapping_button:hover,
QToolButton#edit_button:hover,
QToolButton#trophy_overview_button:hover,
QToolButton#sort_button:hover,
QToolButton#grid_view_button:hover {
    background: rgba(0, 112, 209, 12);
    border-color: rgba(0, 112, 209, 70);
}

QToolButton#delete_button:hover:enabled {
    background: rgba(190, 55, 65, 14);
    border-color: rgba(190, 55, 65, 55);
}

QToolButton#refresh_button:pressed,
QToolButton#global_settings_button:pressed,
QToolButton#input_mapping_button:pressed,
QToolButton#edit_button:pressed,
QToolButton#delete_button:pressed,
QToolButton#trophy_overview_button:pressed,
QToolButton#sort_button:pressed,
QToolButton#grid_view_button:pressed,
QToolButton#grid_view_button:checked {
    background: #0070d1;
    border-color: #0070d1;
}

QToolButton:focus {
    border-color: #0070d1;
    outline: 0;
}

QToolButton:disabled {
    background: transparent;
    border-color: transparent;
}

QFrame#toolbar_separator {
    color: #d8dfe9;
    background: #d8dfe9;
    margin: 5px 6px;
}

/* --- Search field ------------------------------------------------------ */

QLineEdit#search_line_edit {
    background: #ffffff;
    border: 1px solid #d4dce7;
    border-radius: 18px;
    color: #131922;
    font-size: 12px;
    min-height: 32px;
    padding: 0 12px;
    selection-background-color: #0070d1;
    selection-color: #ffffff;
}

QLineEdit#search_line_edit:hover {
    border-color: #b4c0d0;
}

QLineEdit#search_line_edit:focus {
    border-color: #0070d1;
    background: #f2f8ff;
}

QLineEdit#search_line_edit::placeholder-text {
    color: #97a2b2;
    font-style: italic;
}

/* --- Hero row (PS5-style home strip) ----------------------------------- */

QListView#hero_row {
    background: transparent;
    border: 0;
    outline: 0;
}

/* --- Game views -------------------------------------------------------- */

QTreeWidget#cfgs_list,
QListView#cfgs_grid {
    background: transparent;
    border: 0;
    outline: 0;
    color: palette(text);
}

QTreeWidget#cfgs_list::item {
    background: transparent;
    border-bottom: 1px solid rgba(0, 0, 0, 8);
    padding: 6px 10px;
}

QTreeWidget#cfgs_list::item:hover {
    background: rgba(0, 0, 0, 6);
}

QTreeWidget#cfgs_list::item:selected,
QTreeWidget#cfgs_list::item:selected:active,
QTreeWidget#cfgs_list::item:selected:!active {
    background: rgba(0, 112, 209, 60);
    color: #ffffff;
}

QTreeWidget#cfgs_list QHeaderView::section {
    background: #eef2f8;
    color: #5d6878;
    border: 0;
    border-right: 1px solid #dde4ee;
    border-bottom: 1px solid #dde4ee;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 10px;
}

QTreeWidget#cfgs_list QHeaderView::section::sortindicator {
    width: 10px;
    height: 10px;
}

/* --- Selected-game detail panel ---------------------------------------- */

QFrame#game_detail_panel {
    background: #ffffff;
    border: 1px solid #dde4ee;
    border-radius: 12px;
}

QLabel#detail_icon {
    background: transparent;
    border-radius: 8px;
}

QLabel#detail_title {
    color: #131922;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

QLabel#detail_meta {
    color: #697588;
    font-size: 11px;
    background: transparent;
}

QLabel#detail_status {
    color: #00529c;
    font-size: 11px;
    background: rgba(0, 112, 209, 14);
    border: 1px solid rgba(0, 112, 209, 45);
    border-radius: 10px;
    padding: 3px 10px;
}

QPushButton#detail_launch_button {
    background: #0070d1;
    border: 1px solid #0070d1;
    border-radius: 18px;
    color: #ffffff;
    font-weight: 700;
    min-width: 128px;
    padding: 8px 22px;
}

QPushButton#detail_launch_button:hover {
    background: #0066c0;
    border-color: #0066c0;
}

QPushButton#detail_launch_button:pressed {
    background: #005aad;
}

QPushButton#detail_launch_button:disabled {
    background: #edf0f5;
    border-color: #d8dfe9;
    color: #a4adba;
}

/* --- Grid size slider -------------------------------------------------- */

QSlider#grid_size_slider {
    min-width: 90px;
    max-width: 120px;
}

QSlider#grid_size_slider::groove:horizontal {
    background: #dbe2ec;
    border-radius: 2px;
    height: 4px;
}

QSlider#grid_size_slider::sub-page:horizontal {
    background: #0070d1;
    border-radius: 2px;
}

QSlider#grid_size_slider::handle:horizontal {
    background: #0070d1;
    border: 2px solid #ffffff;
    border-radius: 8px;
    height: 16px;
    width: 16px;
    margin: -6px 0;
}

QSlider#grid_size_slider::handle:horizontal:hover {
    background: #2e9bff;
}

/* --- Scroll bars ------------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 22);
    border-radius: 4px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(0, 112, 209, 90);
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: rgba(0, 0, 0, 22);
    border-radius: 4px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(0, 112, 209, 90);
}

QScrollBar::add-line,
QScrollBar::sub-line {
    background: transparent;
    border: 0;
    height: 0;
    width: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* --- Settings dialog --------------------------------------------------- */

QDialog#launcher_settings {
    background: #f4f6fa;
}

QLabel#settings_heading {
    color: #131922;
    font-size: 16px;
    font-weight: 700;
}

QLabel#settings_file {
    color: #6b7686;
    font-size: 11px;
}

QCheckBox {
    color: #2b3542;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #c3ccd9;
    border-radius: 4px;
    background: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #0070d1;
}

QCheckBox::indicator:checked {
    background: #0070d1;
    border-color: #0070d1;
}

QComboBox {
    background: #ffffff;
    border: 1px solid #d4dce7;
    border-radius: 8px;
    color: #131922;
    min-height: 28px;
    padding: 1px 10px;
}

QComboBox:hover {
    border-color: #b4c0d0;
}

QComboBox:focus {
    border-color: #0070d1;
}

QComboBox::drop-down {
    border: 0;
    width: 22px;
}

QComboBox QAbstractItemView {
    background: #ffffff;
    color: #202a36;
    border: 1px solid #d8dfe9;
    border-radius: 6px;
    selection-background-color: #0070d1;
    selection-color: #ffffff;
    outline: 0;
}

QPushButton {
    background: #e9edf4;
    border: 1px solid #d4dce7;
    border-radius: 18px;
    color: #131922;
    min-width: 72px;
    padding: 7px 20px;
}

QPushButton:hover {
    background: #dfe6f0;
    border-color: #0070d1;
}

QPushButton:default {
    background: #0070d1;
    border-color: #0070d1;
    color: #ffffff;
}

QPushButton:default:hover {
    background: #2e9bff;
}

QPushButton:pressed {
    background: #005aad;
}

/* --- In-list editors --------------------------------------------------- */

QComboBox#game_status_editor {
    background: transparent;
    border: 0;
    color: palette(text);
    padding-left: 2px;
}

QComboBox#game_status_editor:focus {
    background: palette(button);
    border-radius: 3px;
}

QComboBox#game_status_editor::drop-down {
    border: 0;
}

QComboBox#game_status_editor QAbstractItemView {
    background: palette(base);
    color: palette(text);
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QLineEdit#game_comment_editor {
    background: transparent;
    border: 0;
    color: palette(text);
    padding-left: 2px;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QLineEdit#game_comment_editor:focus {
    background: palette(base);
    border: 1px solid palette(mid);
    border-radius: 3px;
}

QLabel#game_status_indicator {
    border: 1px solid palette(base);
    border-radius: 6px;
}

/* --- Misc -------------------------------------------------------------- */

QToolTip {
    background: #ffffff;
    color: #202a36;
    border: 1px solid #d4dce7;
    border-radius: 6px;
    padding: 5px 8px;
}

/* --- Empty states ------------------------------------------------------ */

QWidget#empty_state_overlay {
    background: transparent;
}

QLabel#empty_state_icon {
    background: transparent;
}

QLabel#empty_state_title {
    color: #1b2430;
    font-size: 17px;
    font-weight: 700;
    background: transparent;
}

QLabel#empty_state_subtitle {
    color: #697588;
    font-size: 12px;
    background: transparent;
}

QPushButton#empty_state_action {
    background: #0070d1;
    border: 1px solid #0070d1;
    border-radius: 18px;
    color: #ffffff;
    font-weight: 600;
    min-width: 120px;
    padding: 8px 22px;
}

QPushButton#empty_state_action:hover {
    background: #2e9bff;
    border-color: #2e9bff;
}
